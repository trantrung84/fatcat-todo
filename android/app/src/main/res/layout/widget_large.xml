<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#4A2C24" android:singleLine="true" android:ellipsize="end" android:text="Fat Cat Todo"/>
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#B8493A"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="50dp">
            <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ic0" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_circle" android:contentDescription="@null"/>
                <TextView android:id="@+id/tx0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#4A2C24" android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ic1" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_circle" android:contentDescription="@null"/>
                <TextView android:id="@+id/tx1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#4A2C24" android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ic2" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_circle" android:contentDescription="@null"/>
                <TextView android:id="@+id/tx2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#4A2C24" android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ic3" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_circle" android:contentDescription="@null"/>
                <TextView android:id="@+id/tx3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#4A2C24" android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ic4" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_circle" android:contentDescription="@null"/>
                <TextView android:id="@+id/tx4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#4A2C24" android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
            android:paddingEnd="54dp" android:textSize="14sp" android:textColor="#8A675B" android:visibility="gone"/>
        <ImageView android:id="@+id/cat" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="bottom|end"
            android:src="@drawable/widget_cat" android:scaleType="fitEnd" android:adjustViewBounds="true" android:contentDescription="@null"/>
    </FrameLayout>
</LinearLayout>
